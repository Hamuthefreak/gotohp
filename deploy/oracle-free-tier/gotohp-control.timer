[Unit]
Description=Poll the gotohp dashboard for settings and commands

[Timer]
OnBootSec=60s
# 20 seconds is the difference between "it says uploading" and actually seeing
# the file change while a backup runs. The agent is a handful of local reads
# plus two small HTTP calls, which the free 1 GB instance handles easily.
OnUnitActiveSec=60s
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target

# /etc/gotohp-sync/config.env - read by /usr/local/bin/gotohp-sync.
# Owned by root:gotohpsync, mode 0640.

# Watermelon node directory on this box.
# With the chroot SFTP setup from install.sh, Watermelon's base path is /repo.
SRC_DIR=/srv/watermelon/repo

# Ledger, snapshots, gotohp config and credentials.
STATE_DIR=/var/lib/gotohp-sync

GOTOHP_BIN=/usr/local/bin/gotohp-cli
GOTOHP_CONFIG=/var/lib/gotohp-sync/gotohp.config

# Optional: restrict uploads to one stored account (default: the selected one).
# ACCOUNT=you@gmail.com

# Upload concurrency. The free Ampere shape has 2 OCPUs; above 4 rarely helps.
THREADS=3

# How many files are handed to one gotohp invocation. Kept modest so a failure
# only involves a small slice, and so both halves of a Live Photo stay together.
BATCH_SIZE=200

# true = delete each file from the VM after Google confirms it, which is what
# keeps the node from filling up. A path already in the ledger that is on disk
# again (a file uploaded before this was on, or one Watermelon re-sent) is handed
# back to gotohp, so it is checked against Google and removed too - the relay
# itself never deletes anything.
# WARNING: this destroys Watermelon's repository state, and the node can no
# longer be used to restore to the phone. Leave false unless the disk cannot
# hold the library, and read the README first.
DELETE_AFTER_UPLOAD=false

# Pair IMG_1234.HEIC with IMG_1234.MOV so Live Photos keep their motion part.
# Leave true for an iPhone library.
PAIR_LIVE_PHOTOS=true

# Set true to log what would be uploaded instead of uploading (dry run).
DRY_RUN=false

# ---- dashboard control plane ----------------------------------------------
# Written once by install.sh. The agent in gotohp-control.timer posts this box's
# state here and pulls settings back, so no port has to be opened. Empty means
# the agent stays dormant.
CONTROL_URL=

# ---- upload policy (filled in by the dashboard, safe to edit by hand) ------
SAVER=false
USE_QUOTA=false
FORCE_UPLOAD=false
DISABLE_FILTER=false
DATE_FROM_FILENAME=false
EXCLUDE_PATTERN=
ALBUM=
UPLOAD_INCOMPLETE_LIVE=false
UPDATE_EXISTING_TO_LIVE=false
IGNORE_APPLE_METADATA=false
LOG_LEVEL=warn

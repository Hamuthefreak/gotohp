{
	"name": "gotohp-control-plane",
	"version": "1.1.0",
	"description": "Dashboard and pull-side control plane for the gotohp relay",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"dev": "wrangler dev --config wrangler.jsonc --port 8787 --ip 127.0.0.1",
		"start": "npm run build && npm run dev",
		"test": "node test-app.mjs && node test-store-turso.mjs"
	},
	"dependencies": {
		"@freebuff/auth": "^0.1.0",
		"@vercel/blob": "^2.6.1"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"wrangler": "^4.157.0"
	},
	"engines": {
		"node": "22.x"
	},
	"license": "MIT"
}

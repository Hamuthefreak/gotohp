[Unit]
Description=gotohp relay control agent (pull settings from the dashboard)
Documentation=https://github.com/Hamuthefreak/gotohp/tree/main/deploy/control-plane
After=network-online.target gotohp-sync.timer
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gotohp-control
# Never stall the box on a slow dashboard: the unit gives up and the timer
# tries again next minute.
TimeoutStartSec=60
Nice=10

[Unit]
Description=Upload Watermelon backup files to Google Photos (gotohp-cli)
Documentation=https://github.com/Hamuthefreak/gotohp
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gotohpsync
Group=gotohpsync
Environment=GOTOHP_SYNC_CONFIG=/etc/gotohp-sync/config.env
ExecStart=/usr/local/bin/gotohp-sync

# A first push of a whole library can take hours, and a night's backup must not
# be cut off halfway. Hangs are bounded per gotohp invocation by UPLOAD_TIMEOUT
# in the relay instead, so this unit no longer needs to guillotine a long run -
# a stalled upload becomes a failed batch that is retried, not a killed night.
TimeoutStartSec=infinity

# Uploading is I/O bound and must never starve the box that is also serving
# SFTP from the phone.
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes

# /var/lib/gotohp-sync holds the ledger, the gotohp config and the credentials.
StateDirectory=gotohp-sync
StateDirectoryMode=0700
